# =============================================================================
# PortPulse AI — backend environment template
# =============================================================================
# Copy to `.env` next to this file: cp .env.example .env
# (.env is gitignored — never commit real credentials)
# =============================================================================

DATABASE_URL="postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/portflow"
# Managed-Postgres URLs (postgresql://… from Voroa/Render/Heroku) are
# auto-normalised to the psycopg3 driver in app/db.py — paste them as-is if you prefer.
# Supabase session pooler (username MUST carry the project ref):
#   postgresql+psycopg://<user>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Supabase transaction pooler :6543 additionally needs DB_PGBOUNCER=true (see below).
# Managed-Postgres toggles:
#   DB_PGBOUNCER=true  -> disable prepared statements (transaction-pool mode)
#   DB_SSL=true        -> force sslmode=require
DB_PGBOUNCER=false
DB_SSL=false

# ---- Agent layer: IBM Bob only ---------------------------------------------
# auto = IBM Bob when BOB_API_KEY + the `bob` CLI are available;
# otherwise the application uses transparent deterministic engine-grounded text.
LLM_PROVIDER=auto
# BOB_API_KEY="bob_prod_..."      # do NOT commit a real key; set it in your shell instead
# BOB_TEAM_ID=""                  # only for a "general" API key
BOB_CLI=bob
BOB_MAX_TURNS=3
BOB_TIMEOUT_S=240

# ---- API / CORS -------------------------------------------------------------
PORT=8000
# Deployed (Vercel → Voroa proxy): the browser only calls the Vercel origin, so CORS is
# not needed; add your Vercel domain here only if you ever call the Voroa URL directly.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app"

# ---- External data sources --------------------------------------------------
OPEN_METEO_BASE="https://api.open-meteo.com"
REFERENCE_LAT=33.74
REFERENCE_LON=-118.20

# ---- Simulation -------------------------------------------------------------
SIM_SEED=20240817
SIM_HORIZON_HOURS=72

# ---- Shipped feature flags --------------------------------------------------
FEATURE_WEATHER=true
FEATURE_QUALITY=true
FEATURE_UPLOAD=true
FEATURE_TIDAL=true
FEATURE_INCREMENTAL=true
FEATURE_SCENARIOS_EXT=true
